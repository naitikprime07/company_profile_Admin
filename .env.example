# Vite exposes VITE_* values to the browser. Never place secrets in these variables.
VITE_DEV_PORT=5175
VITE_API_BASE_URL=http://localhost:5000/api

# For the deployed (Vercel) admin, set this SAME variable in the Vercel project
# environment (not in this gitignored file) to the HTTPS backend URL, then redeploy:
#   VITE_API_BASE_URL=https://company-profile-be.vercel.app/api
# If it is left unset in a production build, the app falls back to that URL
# automatically (see src/constants/environment.js).

# Public marketing site origin, used by "View" actions that open public pages
# (e.g. a blog article). In local dev it defaults to http://localhost:5173.
# On the deployed (Vercel) admin, set this in the project environment to the
# public site URL, e.g.:
#   VITE_PUBLIC_SITE_URL=https://your-public-site.example.com
